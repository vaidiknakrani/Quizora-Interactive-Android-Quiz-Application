<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdminQuiz" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:statusBarColor">@color/brand_purple_dark</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="materialCardViewStyle">@style/Quiz.Card</item>
        <item name="materialButtonStyle">@style/Quiz.Button</item>
        <item name="radioButtonStyle">@style/Quiz.Radio</item>
    </style>

    <style name="Quiz.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/brand_purple</item>
    </style>

    <!-- Rounded, softly outlined cards used everywhere -->
    <style name="Quiz.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <!-- Rounded pill buttons with a comfortable 52dp touch target -->
    <style name="Quiz.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Answer options look like selectable cards -->
    <style name="Quiz.Radio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Home.Title" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
